rules_version = '2';

// Deploy: firebase deploy --only firestore:rules
// Adjust stricter rules (e.g. Consultations read) once the app no longer needs
// cross-user reads for slot availability.

service cloud.firestore {
  match /databases/{database}/documents {

    match /Users/{userId} {
      allow read: if request.auth != null;
      allow create, update, delete: if request.auth != null
          && request.auth.token.email == userId;
    }

    match /Packages/{packageId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /Consultations/{consultationId} {
      allow read, create, update, delete: if request.auth != null;
    }

    match /Notifications/{notificationId} {
      allow read: if request.auth != null
          && request.auth.uid in resource.data.userIds;
      allow create: if request.auth != null && (
          request.auth.uid in request.resource.data.userIds
          || request.auth.uid == request.resource.data.generatedBy.id
      );
      allow update, delete: if request.auth != null
          && request.auth.uid in resource.data.userIds;
    }

    match /Chats/{chatId} {
      allow read, write: if request.auth != null;
    }

    match /Chats/{chatId}/Messages/{messageId} {
      allow read, write: if request.auth != null;
    }

    match /Blogs/{blogId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /VPNServers/{serverId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
  }
}
